{
  "manifest_version": 3,
  "name": "Conscious",
  "version": "1.0",
  "permissions": ["tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
  {
    "resources": [
      "worker.min.js",
      "tesseract.min.js",
      "tessdata/por.traineddata",
      "tessdata/eng.traineddata"
    ],
    "matches": ["<all_urls>"]
  }
],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["tesseract.min.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
  
}